# Kredensial Threads API (Meta Developer)
THREADS_USER_ID=your_threads_user_id
THREADS_ACCESS_TOKEN=your_threads_long_lived_token

# Gemini API Key (Opsional: untuk auto-generate cerita baru saat episode lokal habis)
GEMINI_API_KEY=your_gemini_api_key

# Setting Jitter (opsional, diset true saat testing lokal untuk lewati delay)
SKIP_JITTER=false
